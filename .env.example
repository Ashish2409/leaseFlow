# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-secure-random-base64-encoded-string-at-least-64-chars

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Database (for production; dev uses docker-compose defaults)
DB_URL=jdbc:postgresql://localhost:5432/leaseflow
DB_USERNAME=leaseflow
DB_PASSWORD=leaseflow
